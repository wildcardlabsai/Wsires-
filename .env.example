# =====================================================================
# CymruSites — environment variables
#
# Copy this file to .env.local for local development. On Vercel, add the
# same variables under Project Settings → Environment Variables.
# =====================================================================

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------
# The canonical URL of this deployment. Used for absolute links in emails,
# Open Graph tags and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The apex domain customer subdomains are issued under, e.g.
# <customer>.cymrusites.co.uk. Does not need a scheme.
NEXT_PUBLIC_ROOT_DOMAIN=cymrusites.co.uk

# ---------------------------------------------------------------------
# Supabase (database, auth, storage)
# Create a project at https://supabase.com, then run every file in
# supabase/migrations/ against it (via the SQL editor, or `supabase db push`
# if you use the Supabase CLI).
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — Project Settings → API → service_role. Server-only,
# never exposed to the browser. Required for Stripe webhooks, the public
# contact/enquiry forms, and the seed scripts.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Stripe (payments)
# Create a Stripe account, then run `npm run stripe:sync` once the plans
# table exists to create the Products/Prices and link them automatically.
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Create a webhook endpoint in the Stripe dashboard pointing at
# <NEXT_PUBLIC_SITE_URL>/api/webhooks/stripe, listening for:
#   checkout.session.completed, invoice.paid, invoice.payment_failed,
#   customer.subscription.updated, customer.subscription.deleted
# then paste its signing secret here.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Resend (transactional email)
# Create an account at https://resend.com and verify a sending domain.
# ---------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="CymruSites <hello@cymrusites.co.uk>"

# Where public-site enquiries and new-order notifications are sent.
ADMIN_NOTIFICATION_EMAIL=hello@cymrusites.co.uk

# ---------------------------------------------------------------------
# Optional: make Supabase Auth's own emails (confirmation, password
# reset) send through Resend too, for a consistent sender domain.
# In the Supabase dashboard: Project Settings → Auth → SMTP Settings:
#   Host: smtp.resend.com   Port: 465   Username: resend
#   Password: <your RESEND_API_KEY>     Sender: <EMAIL_FROM>
# ---------------------------------------------------------------------

# =====================================================================
# CymruSites — environment variables
#
# This is a static marketing site with one server feature: the contact
# form sends an email via Resend. Everything else renders with no
# configuration at all. Copy this file to .env.local for local
# development. On Vercel, add the same variables under Project Settings
# → Environment Variables — none of them are required for a deploy to
# succeed.
# =====================================================================

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------
# The canonical URL of this deployment. Used for absolute links in
# emails, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=cymrusites.co.uk

# ---------------------------------------------------------------------
# Resend (transactional email)
# Create an account at https://resend.com and verify a sending domain.
# Until this is set, contact-form submissions are logged to the server
# console instead of emailed — the form still works, you just don't
# receive the email.
# ---------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="CymruSites <hello@cymrusites.co.uk>"

# Where contact-form enquiries are sent.
ADMIN_NOTIFICATION_EMAIL=hello@cymrusites.co.uk
